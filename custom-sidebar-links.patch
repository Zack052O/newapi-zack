+// ============================================================================
+// Custom Sidebar Links
+// ============================================================================
+
+export type CustomSidebarLink = {
+  /** Display label shown in the sidebar */
+  title: string
+  /** URL — internal path (e.g. "/pricing") or external (e.g. "https://docs.example.com") */
+  url: string
+  /** Optional lucide icon name (e.g. "BookOpen", "ExternalLink") */
+  icon?: string
+  /** Optional badge text */
+  badge?: string
+  /** Minimum role required to see this link (0=guest, 1=user, 10=admin, 100=super admin) */
+  requiredRole?: number
+}
+
+export type CustomSidebarLinksConfig = CustomSidebarLink[]
+
+export function parseCustomSidebarLinks(
+  value: string | null | undefined
+): CustomSidebarLinksConfig {
+  if (!value || value.trim() === '') return []
+  try {
+    const parsed = JSON.parse(value)
+    if (!Array.isArray(parsed)) return []
+    return parsed.filter(
+      (item): item is CustomSidebarLink =>
+        typeof item === 'object' &&
+        item !== null &&
+        typeof item.title === 'string' &&
+        typeof item.url === 'string'
+    )
+  } catch {
+    return []
+  }
+}
+
+export function serializeCustomSidebarLinks(
+  config: CustomSidebarLinksConfig
+): string {
+  return JSON.stringify(config)
+}
