# MySQL 连接（宝塔宿主 MySQL）
# 把 host.docker.internal 保持不变，它指向宿主机
# 只改用户名、密码、数据库名
SQL_DSN=root:YOUR_MYSQL_PASSWORD@tcp(host.docker.internal:3306)/newapi

# 可选：Redis 连接（留空则不用 Redis）
# REDIS_CONN_STRING=redis://:YOUR_REDIS_PASSWORD@host.docker.internal:6379

# 登录会话密钥（随机字符串，多实例必须一致）
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING

# 可选：日志单独数据库
# LOG_SQL_DSN=root:YOUR_MYSQL_PASSWORD@tcp(host.docker.internal:3306)/newapi_log
